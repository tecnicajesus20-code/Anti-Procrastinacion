rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Bloque específico para la colección de tareas de cada usuario
    match /users/{uid}/tasks/{taskId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidTask(request.resource.data);
    }

    // Verifica que el usuario autenticado sea el dueño de la información
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Valida el contrato de datos de la tarea
    function isValidTask(t) {
      return t.keys().hasAll(['title', 'status', 'start', 'end'])
        && t.keys().hasOnly(['title', 'description', 'status', 'dueDate', 'start', 'end'])
        && t.title is string && t.title.size() > 0 && t.title.size() <= 120
        && t.status in ['pending', 'in_progress', 'done']
        && t.start is string && t.end is string
        && t.end > t.start;
    }

    // NOTA: Se eliminó la regla abierta "match /{document=**}" para evitar que
    // cualquier usuario no autenticado acceda a tus colecciones de forma pública.
  }
}
